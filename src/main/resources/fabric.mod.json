{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "issues": "${mod_issue_tracker}",
    "discord": "${mod_discord}"
  },
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.dannbrown.astrosync.AstroSync"
    ],
    "client": [
      "com.dannbrown.astrosync.AstroSyncClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${target_minecraft}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
